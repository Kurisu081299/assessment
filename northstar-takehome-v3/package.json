{
  "name": "northstar",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "migrate": "npm run migrate --workspace server",
    "ingest": "npm run ingest --workspace server",
    "build": "npm run build --workspace web",
    "serve": "npm run serve --workspace server",
    "start": "npm run ingest --workspace server && npm run build --workspace web && npm run serve --workspace server",
    "test": "npm test --workspace server",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web"
  }
}
